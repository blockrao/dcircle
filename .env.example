# Public browser-safe Supabase configuration for local development.
# Copy this file to .env.local and replace both placeholders.
# Never put a service_role key or any secret in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
